# functions
# git clone and cd to a repo directory and run npm/yarn
clone() {
  cd ~/git
  git clone $@
  if [ "$2" ]; then
    cd "$2"
  else
    cd $(basename "$1" .git)
  fi
  nvm use
  if [[ -r "./yarn.lock" ]]; then
    yarn
  elif [[ -r "./package-lock.json" ]]; then
    npm install
  fi
}

# Make a directory and cd to it
take() {
  mkdir -p $@ && cd ${@:$#}
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}


# remove node modules and install fresh
function nfresh(){
  echo "removing node_modules ..."
  rm -rf node_modules
  if [[ -r "./yarn.lock" ]]; then
    yarn
  elif [[ -r "./package-lock.json" ]]; then
    npm install
  fi
}

#  browse chrome bookmarks dep: jq, fzf
bk() {
     bookmarks_path=~/Library/Application\ Support/Google/Chrome/Default/Bookmarks

     jq_script='
        def ancestors: while(. | length >= 2; del(.[-1,-2]));
        . as $in | paths(.url?) as $key | $in | getpath($key) | {name,url, path: [$key[0:-2] | ancestors as $a | $in | getpath($a) | .name?] | reverse | join("/") } | .path + "/" + .name + "\t" + .url'

    jq -r "$jq_script" < "$bookmarks_path" \
        | sed -E $'s/(.*)\t(.*)/\\1\t\x1b[36m\\2\x1b[m/g' \
        | fzf --ansi \
        | cut -d$'\t' -f2 \
        | xargs open
}
# pull a cheatsheet
tldr() {
  curl -m 10 "http://cheat.sh/${1}" 2>/dev/null || printf '%s\n' "[ERROR] Something broke"
}

# colorized man pages
man() {
	env \
		LESS_TERMCAP_mb=$(printf "\e[1;31m") \
		LESS_TERMCAP_md=$(printf "\e[1;31m") \
		LESS_TERMCAP_me=$(printf "\e[0m") \
		LESS_TERMCAP_se=$(printf "\e[0m") \
		LESS_TERMCAP_so=$(printf "\e[1;44;33m") \
		LESS_TERMCAP_ue=$(printf "\e[0m") \
		LESS_TERMCAP_us=$(printf "\e[1;32m") \
			man "$@"
}



# search and add result to vim quickfix
fury(){
   local pat=$1
   local l="${2:-.}"
   local result=$(grep -rn "$pat" $l)
   if [ -z "$result" ]
   then 
        echo "no result found"
   else
        #echo $result
        vim -q <(echo "$result") +:copen
    fi
}

# open remote in browser
# default to current branch
# tested with githib and bitbucket on a macOx (zsh)
gopen(){
  open $(git config remote.origin.url | sed "s/git@\(.*\):\(.*\).git/https:\/\/\1\/\2/")/$1$2
}



share() {
  echo "🚀 Uploading to sprunge"
  
  # Check if input is piped
  if [ -p /dev/stdin ]; then
    url=$(curl -F 'sprunge=<-' http://sprunge.us < /dev/stdin 2> /dev/null | tr -d '\n')
  elif [ -f "$1" ]; then
    url=$(curl -F 'sprunge=<-' http://sprunge.us < "$1" 2> /dev/null | tr -d '\n')
  else
    echo "❌ Error: Invalid input. \n use: share <file> or <cmd> | share"
    return 1
  fi

  if [ $? -eq 0 ]; then
    echo "✅ Upload successful."
    echo $url | tr -d '\n' | pbcopy
    echo "📋 Copied link to clipboard: ${url}"
  else
    echo "❌ Error: Upload failed."
  fi
}

# print to terminal and copy the output of a command to clipboard
copyrun(){
  script -q /dev/null "$@" | tee >(pbcopy)
}

# create a commit with a message of the hex representation of the input string, default to "amir"
# assuming luck_commit is already installed, if not run brew install lucky-commit
magic_commit() {
  local s="${1:-amir}"
  lucky_commit "$(printf %s "$s" | xxd -p)"
}

# Personal tools
alias ask="~/dotfiles/zsh/functions/ask.sh"
alias notes="~/dotfiles/notes.sh"
vite:new() {
  if (( $# < 1 )) || [[ "$1" == -* ]]; then
    echo "Usage: vite:new <project-name> [--pm npm|pnpm|yarn|bun] [--open] [--no-git] [vite-options...]" >&2
    return 2
  fi

  local project_name="$1"
  local pm="npm"
  local open_editor=false
  local init_git=true
  local -a vite_options=()
  shift

  while (( $# )); do
    case "$1" in
      --pm)
        if (( $# < 2 )); then
          echo "vite:new: --pm requires npm, pnpm, yarn, or bun" >&2
          return 2
        fi
        pm="$2"
        shift 2
        ;;
      --open)
        open_editor=true
        shift
        ;;
      --no-git)
        init_git=false
        shift
        ;;
      *)
        vite_options+=("$1")
        shift
        ;;
    esac
  done

  if [[ "$pm" != (npm|pnpm|yarn|bun) ]]; then
    echo "vite:new: unsupported package manager: $pm" >&2
    return 2
  fi
  if [[ -e "$project_name" ]]; then
    echo "vite:new: destination already exists: $project_name" >&2
    return 1
  fi
  if ! command -v "$pm" >/dev/null; then
    echo "vite:new: command not found: $pm" >&2
    return 127
  fi

  case "$pm" in
    npm)  npm create vite@latest "$project_name" -- "${vite_options[@]}" ;;
    pnpm) pnpm create vite "$project_name" "${vite_options[@]}" ;;
    yarn) yarn create vite "$project_name" "${vite_options[@]}" ;;
    bun)  bun create vite "$project_name" "${vite_options[@]}" ;;
  esac || return

  cd "$project_name" || return
  "$pm" install || return

  if $init_git && ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local git_reply
    read "git_reply?Initialize Git repository? [Y/n] "
    if [[ "$git_reply" != [nN]* ]]; then
      [[ -e .gitignore ]] || touch .gitignore
      git init
    fi
  fi

  if $open_editor; then
    local editor="${VISUAL:-$EDITOR}"
    if [[ -z "$editor" ]]; then
      echo "vite:new: --open requires VISUAL or EDITOR" >&2
      return 1
    fi
    $=editor .
  fi
}
