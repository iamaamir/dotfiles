# Non-interactive env only. Do NOT source .aliases here: aliases and
# functions are interactive configuration owned by .zshrc. Sourcing them
# from .zshenv leaks overrides (ls, cat, grep, tldr, man) into every
# subprocess, including vim :! commands and scripts.
# export WEZTERM_CONFIG_FILE="$HOME/dotfiles/.config/wezterm-config/wezterm.lua"
#. "$HOME/.cargo/env"

export DISABLE_TELEMETRY=1

